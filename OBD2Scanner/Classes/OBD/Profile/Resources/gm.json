{
  "schemaVersion": 1,
  "id": "gm",
  "name": "GM (Chevrolet/GMC, candidate)",
  "priority": 100,
  "match": {
    "brands": ["chevrolet", "gmc", "cadillac", "buick"],
    "years": { "from": 2007 }
  },
  "bus": { "elmProtocol": "6" },
  "ecus": [
    {
      "id": "transmission",
      "name": "Transmission",
      "addressing": { "request": "7E2", "response": "7EA" },
      "session": { "kind": "none" },
      "supportedParametersProbe": "udsProbe",
      "parameters": [
        {
          "id": "gm.trans_temp",
          "name": "Transmission fluid temperature",
          "request": "221940",
          "responsePrefix": "621940",
          "extract": { "start": 0, "length": 1 },
          "decode": { "kind": "linear", "scale": 1, "offset": -40 },
          "unit": "°C",
          "range": { "min": -40, "max": 215 },
          "group": "live-slow",
          "categories": ["transmission", "hud"]
        }
      ]
    }
  ]
}

{
  "schemaVersion": 1,
  "id": "toyota-tnga",
  "name": "Toyota / Lexus TNGA (Denso)",
  "priority": 100,
  "match": {
    "brands": ["toyota", "lexus"],
    "years": { "from": 2017 }
  },
  "bus": { "elmProtocol": "6" },
  "ecus": [
    {
      "id": "engine",
      "name": "Двигатель",
      "addressing": { "request": "7E0", "response": "7E8" },
      "session": { "kind": "none" },
      "supportedParametersProbe": "udsProbe",
      "dtc": {
        "read":        { "request": "1902AF", "format": "uds" },
        "freezeFrame": { "request": "1904{dtc}FF", "format": "udsSnapshot" }
      },
      "parameters": [
        {
          "id": "toyota.vin", "name": "VIN (из ECU)",
          "request": "22F190", "responsePrefix": "62F190",
          "extract": { "start": 0, "length": 17 },
          "decode": { "kind": "ascii" },
          "group": "once", "categories": ["info"]
        }
      ]
    },
    {
      "id": "transmission",
      "name": "АКПП",
      "addressing": { "request": "7E1", "response": "7E9" },
      "session": { "kind": "none" },
      "supportedParametersProbe": "udsProbe",
      "parameters": [
        {
          "id": "toyota.atf_pan", "name": "Температура АКПП (поддон)",
          "request": "2182", "responsePrefix": "6182",
          "extract": { "start": 0, "length": 2 },
          "dataLength": 4,
          "decode": { "kind": "linear", "scale": 0.007, "offset": -40 },
          "unit": "°C", "range": { "min": -40, "max": 215 },
          "group": "live-slow", "categories": ["transmission", "hud"]
        },
        {
          "id": "toyota.atf_converter", "name": "Температура АКПП (гидротрансформатор)",
          "request": "2182", "responsePrefix": "6182",
          "extract": { "start": 2, "length": 2 },
          "dataLength": 4,
          "decode": { "kind": "linear", "scale": 0.007, "offset": -40 },
          "unit": "°C", "range": { "min": -40, "max": 215 },
          "group": "live-slow", "categories": ["transmission"]
        }
      ]
    }
  ]
}
